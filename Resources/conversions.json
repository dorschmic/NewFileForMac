{
  "_comment": "Platzhalter: {input} {output} {outputDir} {name}. Werkzeuge ohne Eintrag unter 'tools' werden in /opt/homebrew/bin, /usr/local/bin und /usr/bin gesucht.",
  "tools": {
    "soffice": ["/Applications/LibreOffice.app/Contents/MacOS/soffice"]
  },
  "rules": [
    {
      "_comment": "Video → Audio / GIF",
      "inputs": ["mp4", "mov", "m4v", "mkv", "avi", "webm"],
      "outputs": [
        { "ext": "mp3", "label": "MP3 (Audio)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libmp3lame", "-q:a", "2", "{output}"] },
        { "ext": "m4a", "label": "M4A (Audio, AAC)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "aac", "-b:a", "192k", "{output}"] },
        { "ext": "wav", "label": "WAV (Audio)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "pcm_s16le", "{output}"] },
        { "ext": "gif", "label": "GIF (animiert, 480 px)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vf", "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse", "-loop", "0", "{output}"] },
        { "ext": "mp4", "label": "MP4 (H.264)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-c:v", "libx264", "-preset", "medium", "-crf", "23", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart", "{output}"] }
      ]
    },
    {
      "_comment": "Audio → Audio",
      "inputs": ["mp3", "m4a", "wav", "aif", "aiff", "flac", "ogg", "opus", "aac"],
      "outputs": [
        { "ext": "mp3", "label": "MP3", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libmp3lame", "-q:a", "2", "{output}"] },
        { "ext": "m4a", "label": "M4A (AAC)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "aac", "-b:a", "192k", "{output}"] },
        { "ext": "wav", "label": "WAV", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "pcm_s16le", "{output}"] },
        { "ext": "flac", "label": "FLAC (verlustfrei)", "tool": "ffmpeg",
          "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "flac", "{output}"] }
      ]
    },
    {
      "_comment": "Bilder über sips (in macOS eingebaut, nutzt ImageIO)",
      "inputs": ["heic", "heif", "jpg", "jpeg", "png", "tif", "tiff", "bmp", "gif", "webp"],
      "outputs": [
        { "ext": "jpg", "label": "JPEG", "tool": "sips",
          "args": ["-s", "format", "jpeg", "-s", "formatOptions", "85", "{input}", "--out", "{output}"] },
        { "ext": "png", "label": "PNG", "tool": "sips",
          "args": ["-s", "format", "png", "{input}", "--out", "{output}"] },
        { "ext": "heic", "label": "HEIC", "tool": "sips",
          "args": ["-s", "format", "heic", "{input}", "--out", "{output}"] },
        { "ext": "tiff", "label": "TIFF", "tool": "sips",
          "args": ["-s", "format", "tiff", "{input}", "--out", "{output}"] },
        { "ext": "pdf", "label": "PDF", "tool": "sips",
          "args": ["-s", "format", "pdf", "{input}", "--out", "{output}"] }
      ]
    },
    {
      "_comment": "Textdokumente über textutil (in macOS eingebaut)",
      "inputs": ["docx", "doc", "odt", "rtf", "txt", "html", "htm"],
      "outputs": [
        { "ext": "docx", "label": "Word (DOCX)", "tool": "textutil",
          "args": ["-convert", "docx", "{input}", "-output", "{output}"] },
        { "ext": "rtf", "label": "RTF", "tool": "textutil",
          "args": ["-convert", "rtf", "{input}", "-output", "{output}"] },
        { "ext": "txt", "label": "Reiner Text (TXT)", "tool": "textutil",
          "args": ["-convert", "txt", "{input}", "-output", "{output}"] },
        { "ext": "html", "label": "HTML", "tool": "textutil",
          "args": ["-convert", "html", "{input}", "-output", "{output}"] }
      ]
    },
    {
      "_comment": "Markdown über pandoc (brew install pandoc)",
      "inputs": ["md", "markdown"],
      "outputs": [
        { "ext": "docx", "label": "Word (DOCX)", "tool": "pandoc",
          "args": ["{input}", "-o", "{output}"] },
        { "ext": "html", "label": "HTML", "tool": "pandoc",
          "args": ["{input}", "--standalone", "--metadata", "title={name}", "-o", "{output}"] }
      ]
    },
    {
      "_comment": "Office → PDF und PDF → DOCX über LibreOffice (brew install --cask libreoffice)",
      "inputs": ["docx", "doc", "odt", "rtf", "xlsx", "xls", "ods", "pptx", "ppt", "odp"],
      "outputs": [
        { "ext": "pdf", "label": "PDF", "tool": "soffice",
          "args": ["--headless", "--convert-to", "pdf", "--outdir", "{outputDir}", "{input}"] }
      ]
    },
    {
      "inputs": ["pdf"],
      "outputs": [
        { "ext": "docx", "label": "Word (DOCX)", "tool": "soffice",
          "args": ["--headless", "--infilter=writer_pdf_import", "--convert-to", "docx:MS Word 2007 XML", "--outdir", "{outputDir}", "{input}"] }
      ]
    }
  ]
}
