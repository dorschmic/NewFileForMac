{
  "_comment": "Standardregeln – werden bei jedem App-Start erneuert. Eigene Regeln gehören in conversions.json. Platzhalter: {input} {output} {outputDir} {name}. 'group' = Untermenü, 'via' = Zwischenformat. Eingebaute Werkzeuge: copy, textpdf, pdftext. Gibt es ein Ziel mehrfach, gewinnt die erste Regel, deren Werkzeug installiert ist.",
  "tools": {
    "soffice": ["/Applications/LibreOffice.app/Contents/MacOS/soffice"]
  },
  "installHints": {
    "soffice": "brew install --cask libreoffice",
    "cwebp": "brew install webp",
    "pandoc": "brew install pandoc",
    "ffmpeg": "brew install ffmpeg"
  },
  "rules": [
    {
      "_comment": "Markdown über pandoc",
      "inputs": ["md", "markdown"],
      "outputs": [
        { "ext": "txt",  "label": "Reiner Text (TXT)", "tool": "pandoc", "args": ["{input}", "-t", "plain", "-o", "{output}"] },
        { "ext": "html", "label": "HTML", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--standalone", "--metadata", "pagetitle={name}", "-o", "{output}"] },
        { "ext": "docx", "label": "Word (DOCX)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "-o", "{output}"] },
        { "ext": "odt",  "label": "OpenDocument (ODT)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "-o", "{output}"] },
        { "ext": "rtf",  "label": "RTF", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--standalone", "-o", "{output}"] },
        { "ext": "epub", "label": "E-Book (EPUB)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--metadata", "title={name}", "-o", "{output}"] },
        { "ext": "pdf",  "label": "PDF", "group": "Dokument", "via": "html" }
      ]
    },
    {
      "_comment": "CSV/TSV als Tabelle über pandoc",
      "inputs": ["csv", "tsv"],
      "outputs": [
        { "ext": "md",   "label": "Markdown-Tabelle (MD)", "tool": "pandoc", "args": ["{input}", "-t", "gfm", "-o", "{output}"] },
        { "ext": "html", "label": "HTML-Tabelle", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--standalone", "--metadata", "pagetitle={name}", "-o", "{output}"] },
        { "ext": "docx", "label": "Word-Tabelle (DOCX)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "-o", "{output}"] },
        { "ext": "pdf",  "label": "PDF-Tabelle", "group": "Dokument", "via": "html" }
      ]
    },
    {
      "_comment": "Office über LibreOffice (beste Qualität, falls installiert)",
      "inputs": ["docx", "doc", "odt", "rtf", "xlsx", "xls", "ods", "pptx", "ppt", "odp"],
      "outputs": [
        { "ext": "pdf", "label": "PDF", "group": "Dokument", "tool": "soffice", "args": ["--headless", "--convert-to", "pdf", "--outdir", "{outputDir}", "{input}"] }
      ]
    },
    {
      "inputs": ["xlsx", "xls", "ods"],
      "outputs": [
        { "ext": "csv",  "label": "CSV (erstes Blatt)", "tool": "soffice", "args": ["--headless", "--convert-to", "csv", "--outdir", "{outputDir}", "{input}"] },
        { "ext": "xlsx", "label": "Excel (XLSX)", "tool": "soffice", "args": ["--headless", "--convert-to", "xlsx", "--outdir", "{outputDir}", "{input}"] },
        { "ext": "ods",  "label": "OpenDocument (ODS)", "tool": "soffice", "args": ["--headless", "--convert-to", "ods", "--outdir", "{outputDir}", "{input}"] }
      ]
    },
    {
      "inputs": ["pptx", "ppt", "odp"],
      "outputs": [
        { "ext": "pptx", "label": "PowerPoint (PPTX)", "tool": "soffice", "args": ["--headless", "--convert-to", "pptx", "--outdir", "{outputDir}", "{input}"] },
        { "ext": "odp",  "label": "OpenDocument (ODP)", "tool": "soffice", "args": ["--headless", "--convert-to", "odp", "--outdir", "{outputDir}", "{input}"] }
      ]
    },
    {
      "_comment": "Formatierte Textdokumente über textutil (eingebaut)",
      "inputs": ["docx", "doc", "odt", "rtf", "html", "htm", "webarchive"],
      "outputs": [
        { "ext": "txt",  "label": "Reiner Text (TXT)", "tool": "textutil", "args": ["-convert", "txt", "{input}", "-output", "{output}"] },
        { "ext": "docx", "label": "Word (DOCX)", "group": "Dokument", "tool": "textutil", "args": ["-convert", "docx", "{input}", "-output", "{output}"] },
        { "ext": "doc",  "label": "Word 97 (DOC)", "group": "Dokument", "tool": "textutil", "args": ["-convert", "doc", "{input}", "-output", "{output}"] },
        { "ext": "odt",  "label": "OpenDocument (ODT)", "group": "Dokument", "tool": "textutil", "args": ["-convert", "odt", "{input}", "-output", "{output}"] },
        { "ext": "rtf",  "label": "RTF", "group": "Dokument", "tool": "textutil", "args": ["-convert", "rtf", "{input}", "-output", "{output}"] },
        { "ext": "html", "label": "HTML", "group": "Dokument", "tool": "textutil", "args": ["-convert", "html", "{input}", "-output", "{output}"] },
        { "ext": "pdf",  "label": "PDF", "group": "Dokument", "tool": "textpdf" }
      ]
    },
    {
      "_comment": "Dokumente → Markdown / E-Books über pandoc",
      "inputs": ["docx", "odt", "html", "htm", "epub", "rtf"],
      "outputs": [
        { "ext": "md",   "label": "Markdown (MD)", "tool": "pandoc", "args": ["{input}", "-t", "gfm", "--wrap=none", "-o", "{output}"] },
        { "ext": "txt",  "label": "Reiner Text (TXT)", "tool": "pandoc", "args": ["{input}", "-t", "plain", "-o", "{output}"] },
        { "ext": "docx", "label": "Word (DOCX)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "-o", "{output}"] },
        { "ext": "html", "label": "HTML", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--standalone", "-o", "{output}"] },
        { "ext": "epub", "label": "E-Book (EPUB)", "group": "Dokument", "tool": "pandoc", "args": ["{input}", "--metadata", "title={name}", "-o", "{output}"] }
      ]
    },
    {
      "_comment": "Reine Textdateien (Code, Konfiguration, Notizen): Endung ändern",
      "inputs": ["txt", "text", "md", "markdown", "sh", "zsh", "bash", "command", "py", "rb", "pl", "php", "js", "mjs", "cjs", "ts", "tsx", "jsx", "json", "xml", "yaml", "yml", "toml", "ini", "cfg", "conf", "env", "log", "csv", "tsv", "css", "scss", "swift", "c", "h", "cpp", "hpp", "m", "mm", "java", "kt", "go", "rs", "sql", "tex", "r", "lua", "srt", "vtt"],
      "outputs": [
        { "ext": "txt", "label": "Text (TXT)", "tool": "copy" },
        { "ext": "md",  "label": "Markdown (MD)", "tool": "copy" }
      ]
    },
    {
      "_comment": "Reine Textdateien → Dokument (textutil / eingebauter PDF-Druck)",
      "inputs": ["txt", "text", "md", "markdown", "sh", "zsh", "bash", "command", "py", "rb", "pl", "php", "js", "mjs", "cjs", "ts", "tsx", "jsx", "json", "xml", "yaml", "yml", "toml", "ini", "cfg", "conf", "env", "log", "csv", "tsv", "css", "scss", "swift", "c", "h", "cpp", "hpp", "m", "mm", "java", "kt", "go", "rs", "sql", "tex", "r", "lua", "srt", "vtt"],
      "outputs": [
        { "ext": "pdf",  "label": "PDF", "group": "Dokument", "tool": "textpdf" },
        { "ext": "docx", "label": "Word (DOCX)", "group": "Dokument", "tool": "textutil", "args": ["-format", "txt", "-convert", "docx", "{input}", "-output", "{output}"] },
        { "ext": "odt",  "label": "OpenDocument (ODT)", "group": "Dokument", "tool": "textutil", "args": ["-format", "txt", "-convert", "odt", "{input}", "-output", "{output}"] },
        { "ext": "rtf",  "label": "RTF", "group": "Dokument", "tool": "textutil", "args": ["-format", "txt", "-convert", "rtf", "{input}", "-output", "{output}"] },
        { "ext": "html", "label": "HTML", "group": "Dokument", "tool": "textutil", "args": ["-format", "txt", "-convert", "html", "{input}", "-output", "{output}"] }
      ]
    },
    {
      "inputs": ["txt", "text", "md", "markdown", "sh", "zsh", "bash", "command", "py", "rb", "pl", "php", "js", "mjs", "cjs", "ts", "tsx", "jsx", "json", "xml", "yaml", "yml", "toml", "ini", "cfg", "conf", "env", "log", "csv", "tsv", "css", "scss", "swift", "c", "h", "cpp", "hpp", "m", "mm", "java", "kt", "go", "rs", "sql", "tex", "r", "lua", "srt", "vtt"],
      "outputs": [
        { "ext": "py",    "label": "Python (.py)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "sh",    "label": "Shell-Skript (.sh)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "zsh",   "label": "Zsh-Skript (.zsh)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "command", "label": "Doppelklick-Skript (.command)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "js",    "label": "JavaScript (.js)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "ts",    "label": "TypeScript (.ts)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "json",  "label": "JSON (.json)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "csv",   "label": "CSV (.csv)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "xml",   "label": "XML (.xml)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "yaml",  "label": "YAML (.yaml)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "toml",  "label": "TOML (.toml)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "ini",   "label": "INI (.ini)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "css",   "label": "CSS (.css)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "swift", "label": "Swift (.swift)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "c",     "label": "C (.c)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "cpp",   "label": "C++ (.cpp)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "java",  "label": "Java (.java)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "go",    "label": "Go (.go)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "rs",    "label": "Rust (.rs)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "rb",    "label": "Ruby (.rb)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "php",   "label": "PHP (.php)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "sql",   "label": "SQL (.sql)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "tex",   "label": "LaTeX (.tex)", "group": "Endung ändern", "tool": "copy" },
        { "ext": "log",   "label": "Log (.log)", "group": "Endung ändern", "tool": "copy" }
      ]
    },
    {
      "_comment": "PDF",
      "inputs": ["pdf"],
      "outputs": [
        { "ext": "txt",  "label": "Text (TXT)", "tool": "pdftext" },
        { "ext": "png",  "label": "PNG (erste Seite)", "group": "Bild", "tool": "sips", "args": ["-s", "format", "png", "{input}", "--out", "{output}"] },
        { "ext": "jpg",  "label": "JPEG (erste Seite)", "group": "Bild", "tool": "sips", "args": ["-s", "format", "jpeg", "-s", "formatOptions", "90", "{input}", "--out", "{output}"] },
        { "ext": "docx", "label": "Word (DOCX)", "group": "Dokument", "tool": "soffice", "args": ["--headless", "--infilter=writer_pdf_import", "--convert-to", "docx:MS Word 2007 XML", "--outdir", "{outputDir}", "{input}"] }
      ]
    },
    {
      "_comment": "WebP direkt über cwebp (kann png/jpg/tiff lesen)",
      "inputs": ["png", "jpg", "jpeg", "tif", "tiff"],
      "outputs": [
        { "ext": "webp", "label": "WebP", "tool": "cwebp", "args": ["-quiet", "-q", "85", "{input}", "-o", "{output}"] }
      ]
    },
    {
      "_comment": "Bilder über sips (eingebaut, nutzt ImageIO) – inkl. RAW-Fotos",
      "inputs": ["heic", "heif", "jpg", "jpeg", "png", "tif", "tiff", "bmp", "gif", "webp", "avif", "psd", "ico", "icns", "tga", "jp2", "exr", "dng", "cr2", "cr3", "nef", "arw", "raf", "orf"],
      "outputs": [
        { "ext": "jpg",  "label": "JPEG", "tool": "sips", "args": ["-s", "format", "jpeg", "-s", "formatOptions", "85", "{input}", "--out", "{output}"] },
        { "ext": "png",  "label": "PNG", "tool": "sips", "args": ["-s", "format", "png", "{input}", "--out", "{output}"] },
        { "ext": "heic", "label": "HEIC", "tool": "sips", "args": ["-s", "format", "heic", "{input}", "--out", "{output}"] },
        { "ext": "webp", "label": "WebP", "via": "png" },
        { "ext": "avif", "label": "AVIF", "tool": "sips", "args": ["-s", "format", "avif", "{input}", "--out", "{output}"] },
        { "ext": "pdf",  "label": "PDF", "tool": "sips", "args": ["-s", "format", "pdf", "{input}", "--out", "{output}"] },
        { "ext": "tiff", "label": "TIFF", "group": "Weitere", "tool": "sips", "args": ["-s", "format", "tiff", "{input}", "--out", "{output}"] },
        { "ext": "gif",  "label": "GIF", "group": "Weitere", "tool": "sips", "args": ["-s", "format", "gif", "{input}", "--out", "{output}"] },
        { "ext": "bmp",  "label": "BMP", "group": "Weitere", "tool": "sips", "args": ["-s", "format", "bmp", "{input}", "--out", "{output}"] },
        { "ext": "ico",  "label": "Icon (ICO, 256 × 256)", "group": "Weitere", "tool": "sips", "args": ["-Z", "256", "-p", "256", "256", "-s", "format", "ico", "{input}", "--out", "{output}"] },
        { "ext": "psd",  "label": "Photoshop (PSD)", "group": "Weitere", "tool": "sips", "args": ["-s", "format", "psd", "{input}", "--out", "{output}"] }
      ]
    },
    {
      "_comment": "Animiertes GIF → Video",
      "inputs": ["gif"],
      "outputs": [
        { "ext": "mp4",  "label": "MP4 (H.264)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-vf", "scale=trunc(iw/2)*2:trunc(ih/2)*2", "-movflags", "+faststart", "{output}"] },
        { "ext": "webm", "label": "WebM (VP9)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-c:v", "libvpx-vp9", "-crf", "32", "-b:v", "0", "{output}"] }
      ]
    },
    {
      "_comment": "Video über ffmpeg",
      "inputs": ["mp4", "mov", "m4v", "mkv", "avi", "webm", "wmv", "flv", "mpg", "mpeg", "3gp", "m2ts", "mts"],
      "outputs": [
        { "ext": "mp4",  "label": "MP4 (H.264)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-map", "0:v:0", "-map", "0:a:0?", "-c:v", "libx264", "-preset", "medium", "-crf", "23", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k", "-movflags", "+faststart", "{output}"] },
        { "ext": "mov",  "label": "QuickTime (MOV, H.264)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-map", "0:v:0", "-map", "0:a:0?", "-c:v", "libx264", "-preset", "medium", "-crf", "23", "-pix_fmt", "yuv420p", "-c:a", "aac", "-b:a", "160k", "{output}"] },
        { "ext": "mkv",  "label": "Matroska (MKV, ohne Neukodierung)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-map", "0", "-c", "copy", "{output}"] },
        { "ext": "webm", "label": "WebM (VP9)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-map", "0:v:0", "-map", "0:a:0?", "-c:v", "libvpx-vp9", "-crf", "32", "-b:v", "0", "-c:a", "libopus", "{output}"] },
        { "ext": "gif",  "label": "GIF (animiert, 480 px)", "group": "Video", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vf", "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse", "-loop", "0", "{output}"] },
        { "ext": "mp3",  "label": "MP3", "group": "Nur Audio", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libmp3lame", "-q:a", "2", "{output}"] },
        { "ext": "m4a",  "label": "M4A (AAC)", "group": "Nur Audio", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "aac", "-b:a", "192k", "{output}"] },
        { "ext": "wav",  "label": "WAV", "group": "Nur Audio", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "pcm_s16le", "{output}"] },
        { "ext": "flac", "label": "FLAC (verlustfrei)", "group": "Nur Audio", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "flac", "{output}"] },
        { "ext": "opus", "label": "Opus", "group": "Nur Audio", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libopus", "-b:a", "128k", "{output}"] },
        { "ext": "jpg",  "label": "Standbild (JPEG, erstes Bild)", "group": "Standbild", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-frames:v", "1", "-q:v", "2", "{output}"] },
        { "ext": "png",  "label": "Standbild (PNG, erstes Bild)", "group": "Standbild", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-frames:v", "1", "{output}"] }
      ]
    },
    {
      "_comment": "Audio über ffmpeg",
      "inputs": ["mp3", "m4a", "wav", "aif", "aiff", "flac", "ogg", "opus", "aac", "wma", "caf"],
      "outputs": [
        { "ext": "mp3",  "label": "MP3", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libmp3lame", "-q:a", "2", "{output}"] },
        { "ext": "m4a",  "label": "M4A (AAC)", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "aac", "-b:a", "192k", "{output}"] },
        { "ext": "wav",  "label": "WAV", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "pcm_s16le", "{output}"] },
        { "ext": "aiff", "label": "AIFF", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "pcm_s16be", "{output}"] },
        { "ext": "flac", "label": "FLAC (verlustfrei)", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "flac", "{output}"] },
        { "ext": "opus", "label": "Opus", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libopus", "-b:a", "128k", "{output}"] },
        { "ext": "ogg",  "label": "OGG (Opus)", "tool": "ffmpeg", "args": ["-hide_banner", "-loglevel", "error", "-i", "{input}", "-vn", "-c:a", "libopus", "-b:a", "128k", "{output}"] }
      ]
    }
  ]
}
